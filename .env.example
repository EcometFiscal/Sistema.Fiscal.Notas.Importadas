# Producao (Vercel): use a string do CONNECTION POOLING do Supabase, porta 6543.
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
PGSSLMODE=require

# Vazio = link aberto, sem senha. Preencher liga a trava sem mexer no codigo.
SENHA_ACESSO=

# Desenvolvimento local com o docker-compose deste repositorio:
# DATABASE_URL=postgresql+psycopg2://lastro:lastro@localhost:5432/lastro
